+/*
+ * The only resource limit WASI can report is the shadow stack, whose bounds
+ * wasm-ld exports as __stack_low and __stack_high (-z stack-size at link
+ * time). PostgreSQL uses it to cap max_stack_depth so that
+ * check_stack_depth() fires before the stack runs into static data.
+ */
+extern char __stack_low[], __stack_high[];
+
 static int
 getrlimit(int resource, struct rlimit *rlim) {
+    if (resource == RLIMIT_STACK) {
+        rlim->rlim_cur = rlim->rlim_max = (unsigned long) (__stack_high - __stack_low);
+        return 0;
+    }
+    errno = EINVAL;
     return -1;
 }
 
