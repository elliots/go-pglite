diff --git a/src/include/port/wasm_common.h b/src/include/port/wasm_common.h
index 6f53f0f..6e9328d 100644
--- a/src/include/port/wasm_common.h
+++ b/src/include/port/wasm_common.h
@@ -53,10 +53,18 @@
 #define PG_FORCE_DISABLE_INLINE
 
 
+/*
+ * max_stack_depth counts the shadow stack in linear memory, but recursion
+ * also consumes the native stack of the WebAssembly runtime, which traps
+ * when it runs out (wasmtime allows at most 2MB). Measured against that
+ * limit, PostgreSQL's check fires first for PL/pgSQL and SQL function
+ * recursion at 256kB, and no longer at 512kB.
+ */
 #define WASM_PGOPTS \
         "-c", "log_checkpoints=false",\
         "-c", "search_path=pg_catalog",\
         "-c", "exit_on_error=true",\
+        "-c", "max_stack_depth=256kB",\
         "-c", "ignore_invalid_pages=on",\
         "-c", "temp_buffers=8MB",\
         "-c", "work_mem=4MB",\
