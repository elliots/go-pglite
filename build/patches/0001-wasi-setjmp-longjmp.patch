+/*
+ * wasi-libc declares sigsetjmp/siglongjmp but does not implement them. WASI
+ * has no signal masks, so plain setjmp/longjmp (libsetjmp, implemented with
+ * WebAssembly exception handling) are equivalent. sigjmp_buf is already a
+ * typedef of jmp_buf in wasi-libc's <setjmp.h>.
+ */
+#include <setjmp.h>
+#define sigsetjmp(x,y) setjmp(x)
+#define siglongjmp longjmp
